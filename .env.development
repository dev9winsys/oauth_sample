NODE_ENV=develop

PORT=4000

JWT_ISSUER=issuer
JWT_PUBLIC_KEY=pubkey
JWT_SECRET=secret
JWT_EXPIRES_IN=1h
AUTH_ENABLE=true
API_KEY=your-secret-api-key-here
API_KEY_CREATE=your-secret-api-key-create
API_KEY_READ=your-secret-api-key-read
API_KEY_UPDATE=your-secret-api-key-update
API_KEY_DELETE=your-secret-api-key-delete

TRACING=true
DEBUG=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=auth
DB_SCHEMA=auth
DB_TZ=Asia/Tokyo
DB_LOGGING=true
SYNCHRONIZE=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@example.com
SERVICE_NAME=AuthJwt
SERVICE_URL=http://localhost:4000