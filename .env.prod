NODE_ENV=prod

PORT=4000

JWT_ISSUER=issuer
JWT_PUBLIC_KEY=pubkey
# JWT_SECRET must be set to a strong, random value via secure deployment-specific environment variables
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=1h
AUTH_ENABLE=true
# API_KEY must be set to a strong, random value via secure deployment-specific environment variables
# API_KEY=CHANGE_ME_IN_PRODUCTION
# API_KEY_CREATE=CHANGE_ME_IN_PRODUCTION
# API_KEY_READ=CHANGE_ME_IN_PRODUCTION
# API_KEY_UPDATE=CHANGE_ME_IN_PRODUCTION
# API_KEY_DELETE=CHANGE_ME_IN_PRODUCTION

TRACING=true
DEBUG=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=auth
DB_SCHEMA=auth
DB_TZ=Asia/Tokyo
DB_LOGGING=true
SYNCHRONIZE=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@example.com
SERVICE_NAME=AuthJwt
SERVICE_URL=https://your-production-domain.com